# Supabase (required for auth, membership, contact form, admin)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Dev auth assist (local + preview only) — Mailinator API token to auto-fill signup OTP on /verify-email
# MAILINATOR_API_KEY=
# DEV_AUTH_ASSIST=1
# VITE_TEST_USER_EMAIL=nestbean-test-user@mailinator.com
# VITE_TEST_USER_PASSWORD=NestbeanTestUser1!

# Server-only (Vercel / supabase CLI — never VITE_)
# SUPABASE_SERVICE_ROLE_KEY=
# ANALYTICS_IP_SALT=long-random-string
# CRON_SECRET=long-random-string
